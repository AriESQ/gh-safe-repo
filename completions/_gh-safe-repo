_gh_safe_repo_commands() {
    local -a commands
    commands=(
        'new:Create an empty repo with safe defaults'
        'push:Create a repo and push a local git repo into it'
        'copy:Create a repo and copy an existing one into it, history and all (not a fork)'
        'audit:Report settings drift on an existing repo without changing anything'
        'fix:Audit an existing repo and apply safe defaults'
        'scan:Scan a local directory for secrets (no GitHub interaction)'
    )
    _describe -t commands 'gh-safe-repo command' commands
}

