# fish completion for gh-safe-repo
# Generated by `gh-safe-repo --completion fish`; do not edit.
#   load it:  gh-safe-repo --completion fish | source
#   or copy this file to ~/.config/fish/completions/gh-safe-repo.fish

# The command: the first word that is neither an option nor an option's value.
function __gh_safe_repo_cmd
    set -l tokens (commandline -opc)
    set -e tokens[1]
    set -l skip 0
    for t in $tokens
        if test $skip -eq 1
            set skip 0
        else if contains -- $t --config
            set skip 1
        else if string match -q -- '-*' $t
            continue
        else
            echo $t
            return 0
        end
    end
    return 1
end

function __gh_safe_repo_using
    set -l cmd (__gh_safe_repo_cmd)
    test "$cmd" = "$argv[1]"
end

complete -c gh-safe-repo -e
complete -c gh-safe-repo -f

